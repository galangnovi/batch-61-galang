<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/css/style.css">
    <title>Get In Touch</title>
</head>
<body>
  <script src="/assets/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script> 
      {{> navbar}}
    <div class="container-form">
      <Form class="get-in-touch" method="post">
        <H1>GET IN TOUCH</H1>
        <div class="mb-3">
          <label for="formGroupExampleName" class="form-label">Nama</label>
          <input type="text" class="form-control" id="formGroupExampleName" name="Nama">
        </div>
        <div class="mb-3">
          <label for="formGroupExampleEmail" class="form-label">Email</label>
          <input type="text" class="form-control" id="formGroupExampleEmail" name="Email">
        </div>
        <div class="mb-3">
          <label for="formGroupExamplePhoneNumber" class="form-label">Phone Number</label>
          <input type="text" class="form-control" id="formGroupExamplePhoneNumber" name="Phone Number">
        </div>
        <label for="formGroupExampleInput" class="form-label">Subject</label>
          <select class="form-select" aria-label="Default select example" id="option" name="Subject">
            <option selected value="not defined"></option>
            <option value="Important">Important</option>
            <option value="Career">Career</option>
            <option value="Message">Message</option>
          </select>
          <br>
        <div class="mb-3">
          <label for="exampleFormControlTextarea1" class="form-label" >Your Message</label>
          <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" name="Your Message"></textarea>
        </div>
        <div class="submit-box">
          <a class="nav-link" href="#">
            <button type="submit" class="btn btn-dark" onclick="getData1(event)" style="border-radius: 30px; margin-top: 20px; padding: 5px 30px; font-weight: bold;">Submit</button>
          </a>
      </div>
      </Form>
    </div>
</body>
</html>