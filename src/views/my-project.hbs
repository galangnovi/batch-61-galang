<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <title>Document</title>
</head>
<body class="fr">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script> 
    {{>navbar}}
    <div class="container-fr">
        <form class="get-in-form" id="projectForm" enctype="multipart/form-data" action="/my-project" method="POST">
            <h1>ADD MY PROJECT</h1>
            <br>
            <div class="mb-3">
                <label for="formGroupExampleEmail" class="form-label">Email</label>
                <input type="text" class="form-control" id="email" name="email">
            </div>
            <div class="date-form">
                <div class="mb-4">
                    <label for="formGroupExampleEmail" class="form-label">Start Date</label>
                    <input type="date" name="start" class="form-control 1" id="startDate">
                </div>
                <div class="mb-4">
                    <label for="formGroupExampleEmail" class="form-label">End date</label>
                    <input type="date" name="end" class="form-control 1" id="endDate">
                </div>
            </div>
            <div class="mb-3">
                <label for="exampleFormControlTextarea1" class="form-label">Description</label>
                <textarea class="form-control" id="desc" rows="3" name="desc"></textarea>
            </div>
            <div class="check-form">
                <label for="formGroupExampleInput" class="form-label">Technologies</label>
                <div class="check-b">
                    <div class="mb-5">
                        <input type="checkbox" name="techno" id="node" value="Node JS">
                        <label for="node" class="form-label1" >Node JS</label>
                    </div>
                    <div class="mb-5">
                        <input type="checkbox" name="techno" id="next" value="Next JS">
                        <label for="next" class="form-label1">Next JS</label>
                    </div>
                </div>
                <div class="check-b">
                    <div class="mb-5">
                        <input type="checkbox" name="techno" id="react" value="React JS">
                        <label for="react" class="form-label1">React JS</label>
                    </div>
                    <div class="mb-5">
                        <input type="checkbox" name="techno" id="tysc" value="TypeScript">
                        <label for="tysc" class="form-label1">TypeScript</label>
                    </div>
                </div>   
            </div>
            <div class="mb-3">
                <div class="mb-3">
                    <label for="formFileMultiple" class="form-label">Upload Image</label>
                    <input class="form-control" type="file" id="image" multiple name="image">
                </div>   
            </div>
            <div class="submit-box">  
                <button type="submit" class="btn btn-dark" style="border-radius: 30px; margin-top: 20px; padding: 5px 10px; font-weight: bold;">Submit</button>
            </div>
        </form>
    </div>
    {{!-- <script src="/assets/js/script.js"></script> --}}
    <br>
    <div class="container-cad" id="projectCard">
        <h1>My Project</h1>
    </div>
    <div class="container-card">
            {{#if projects.length}}
            {{#each projects}}
            <a href="/my-project/{{this.id}}" style="text-decoration: none; color:black">
            <div class="card" style="width: 18rem; margin: 10px; bg">
                <img src="{{this.image_url}}" class="imagProject" alt="Gambar">
                <div class="card-body">
                    <b><h7 class="card-title">{{this.email}}</h7></b><br>
                    <p style="font-size: 12px;">Duration: {{this.month_duration}} Bulan</p>
                    <div style="width: 100%; height: 80px; overflow:hidden; font-size:13px; text-align: justify;">
                    <p class="card-text">{{this.description}}</p>
                    </div>
                    <div style="margin-top: 10px;">
                        <div>{{{techHTML}}}</div> <!-- ← ini untuk icon -->
                    </div>
                    <div class="submited">
                        <a href="/my-project/{{this.id}}/edit">
                            <button type="button" class="btn-edit btn btn-dark" style="width: 110px;">Edit</button>
                        </a>
                        <form action="/my-project/{{this.id}}/delete" method="POST" style="display:inline; margin-left:20px">
                            <button type="submit" class="btn-delete btn btn-dark" style="width: 110px;">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
            </a>
            {{/each}}
            {{else}}
            <p>Tidak ada proyek yang tersedia.</p>
            {{/if}}
    </div>                    
</body>
</html>
